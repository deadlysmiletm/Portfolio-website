        {
            PROJECT.map((project) => (
                <ProjectCard {...project }/>
            ))
        }
    </div>
</div>
<div class="my-20"></div>
{
    PROJECT.map(project => (
        <SectionDivider/>
        <ProjectArticle {...project}/>
    ))
}