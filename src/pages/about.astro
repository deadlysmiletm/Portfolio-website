---
import GithubIcon from "../components/Icons/GithubIcon.astro";
import ItchIoIcon from "../components/Icons/ItchIoIcon.astro";
import LinkedInIcon from "../components/Icons/LinkedInIcon.astro";
import MailIcon from "../components/Icons/MailIcon.astro";
import SketchfabIcon from "../components/Icons/SketchfabIcon.astro";
---

<div class="text-center mb-8 lg:mb-10">
    <h1 class="mb-8 text-5xl tracking-tight font-bold text-white">
        Welcome to my <span class="font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-rose-600 via-red-400 to-orange-500">Portfolio</span>
    </h1>
       <p class="px-0 md:px-36 lg:px-80 font-light text-gray-500 text-wrap sm:text-base dark:text-gray-400">
           Hi! I'm 
           <a class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-red-500 to-orange-600 transition-all duration-200 ease-in-out hover:text-lg"
        href="https://www.linkedin.com/in/lucasconti/"
        target="_blank",
        rel="linkedin">
            Lucas Conti</a>.
        +7 years of experience. <span class="font-bold opacity-80">Senior Unity Developer</span> from <span class="font-bold">Argentina</span>, focused on creating immersive and exciting experiences.
       </p>
</div>

<div class="flex w-52 h-12 mx-auto mb-12 rounded-full bg-gradient-to-tr from-rose-500/80 to-red-400/80 p-[0.1rem] shadow-lg shadow-black/0 transition-all duration-200 ease-in-out hover:shadow-black/60">
    <a href="/lucas-conti-cv.pdf" download="Lucas Conti - CV.pdf" class="flex-1 flex font-bold items-center justify-center text-[1.05rem] text-gray-200/90 bg-gray-950/75 px-2 py-1 rounded-full transition-all duration-200 ease-in-out hover:bg-black/0 hover:text-black hover:font-bold hover:text-[1.10rem] hover:py-1">Download my CV</a>
</div>


<ul class="flex flex-row gap-x-5 justify-center mb-8 lg:mb-12">
    <li>
        <a href="https://www.github.com/deadlysmiletm" target="_blank">
            <GithubIcon/>
        </a>
    </li>
    <li>
        <a href="https://www.linkedin.com/in/lucasconti/" target="_blank">
            <LinkedInIcon/>
        </a>
    </li>
    <li>
        <a href="https://deadlysmile.itch.io/" target="_blank">
            <ItchIoIcon/>
        </a>
    </li>
    <li>
        <a href="https://sketchfab.com/deadlysmiletm" target="_blanck">
            <SketchfabIcon/>
        </a>
    </li>
    <li>
        <a href="mailto:lucas.leonardo.conti@gmail.com" target="_blank">
            <MailIcon/>
        </a>
    </li>
</ul>